// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Log {
  id String @id @default(uuid())

  serviceName String
  environment Environment

  level   LogLevel
  message String

  traceId String?
  spanId  String?

  timestamp DateTime  @default(now())
  expiresAt DateTime?

  metadata Json?

  requestId String?

  organizationId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id])

  createdAt DateTime @default(now())

  @@index([timestamp])
  @@index([serviceName])
  @@index([traceId])
  @@index([environment])
}

model Incident {
  id          String @id @default(uuid())
  fingerprint String

  title    String
  severity Severity

  firstSeen DateTime
  lastSeen  DateTime

  occurrenceCount Int @default(1)

  logs Log[]

  projectId String

  requestId String?

  project Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fingerprint, projectId])
  @@index([severity])
  @@index([lastSeen])
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Environment {
  DEV
  STAGING
  PROD
}

model User {
  id String @id @default(uuid())

  email    String @unique
  password String
  name     String

  memberships Membership[]

  ownedOrganizations Organization[] @relation("OrganizationOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id String @id @default(uuid())

  name String

  ownerId String
  owner   User   @relation("OrganizationOwner", fields: [ownerId], references: [id])

  memberships Membership[]

  projects Project[]

  anomalies Anomaly[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id String @id @default(uuid())

  role MembershipRole @default(MEMBER)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
}

model Project {
  id String @id @default(uuid())

  name String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  logs Log[]

  incidents Incident[]
  apiKeys   ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model ApiKey {
  id String @id @default(uuid())

  name String

  key String @unique

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
}

enum AnomalyStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}
model Anomaly {
  id                 String   @id @default(cuid())

  type               String
  severity           String

  message            String

  currentValue       Float
  previousValue      Float

  increasePercentage Float

  status AnomalyStatus @default(ACTIVE)

  acknowledgedAt DateTime?

  acknowledgedById String?
  resolvedById String?

  detectedAt         DateTime @default(now())

  resolvedAt         DateTime?

  organizationId     String

  organization Organization @relation(fields: [organizationId],references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}