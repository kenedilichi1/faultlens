// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Log {
  id String @id @default(uuid())

  serviceName String
  environment Environment

  level   LogLevel
  message String

  traceId String?
  spanId  String?

  timestamp DateTime  @default(now())
  expiresAt DateTime?

  metadata Json?

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id])

  createdAt DateTime @default(now())

  @@index([timestamp])
  @@index([serviceName])
  @@index([traceId])
  @@index([environment])
}

model Incident {
  id          String   @id @default(uuid())
  fingerprint String   @unique
  title       String
  severity    Severity

  firstSeen DateTime
  lastSeen  DateTime

  occurrenceCount Int @default(1)

  logs Log[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([severity])
  @@index([lastSeen])
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Environment {
  DEV
  STAGING
  PROD
}

model User {
  id        String   @id @default(uuid())

  email     String   @unique
  password  String
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}